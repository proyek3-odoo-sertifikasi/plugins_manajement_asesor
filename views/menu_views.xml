<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===================== -->
    <!-- Menu Definitions      -->
    <!-- ===================== -->

    <!-- Top Menu: Penugasan Asesor - Admin LSP only -->
    <menuitem
        id="lsp_penugasan_menu_root"
        name="Penugasan Asesor"
        sequence="100"
        groups="plugins_manajement_asesor.group_admin_lsp"
    />

    <!-- Action: Penugasan Asesor -->
    <record id="lsp_penugasan_action_penugasan" model="ir.actions.act_window">
        <field name="name">Penugasan Asesor</field>
        <field name="res_model">lsp.penugasan.asesor</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Belum ada penugasan asesor.
            </p>
            <p>
                Buat penugasan baru dari menu Jadwal Ujian.
            </p>
        </field>
    </record>

    <!-- Menu: Penugasan Asesor - Admin LSP only -->
    <menuitem
        id="lsp_penugasan_menu_semua_penugasan"
        name="Penugasan Asesor"
        parent="lsp_penugasan_menu_root"
        action="lsp_penugasan_action_penugasan"
        sequence="10"
        groups="plugins_manajement_asesor.group_admin_lsp"
    />

    <!-- Top Menu: Jadwal Ujian - Admin LSP only -->
    <menuitem
        id="lsp_jadwal_ujian_menu_root"
        name="Jadwal Ujian"
        sequence="110"
        groups="plugins_manajement_asesor.group_admin_lsp"
    />

    <!-- Action: Jadwal Ujian -->
    <record id="lsp_penugasan_action_jadwal_ujian" model="ir.actions.act_window">
        <field name="name">Jadwal Ujian</field>
        <field name="res_model">lsp.jadwal.ujian</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Belum ada jadwal ujian.
            </p>
            <p>
                Buat jadwal ujian baru untuk memulai proses penugasan asesor.
            </p>
        </field>
    </record>

    <!-- Menu: Jadwal Ujian - Admin LSP only -->
    <menuitem
        id="lsp_penugasan_menu_jadwal_ujian"
        name="Jadwal Ujian"
        parent="lsp_jadwal_ujian_menu_root"
        action="lsp_penugasan_action_jadwal_ujian"
        sequence="10"
        groups="plugins_manajement_asesor.group_admin_lsp"
    />

    <!-- ============================================== -->
    <!-- Menu Overrides for other modules to apply RBAC -->
    <!-- ============================================== -->

    <!-- Restrict Registrasi Menus to Admin LSP -->
    <menuitem id="plugins_registrasi.menu_plugins_registrasi_root" name="Data Asesi" sequence="80" groups="plugins_manajement_asesor.group_admin_lsp"/>
    <menuitem id="plugins_registrasi.menu_registrasi_asesi" name="Data Asesi" parent="plugins_registrasi.menu_plugins_registrasi_root" groups="plugins_manajement_asesor.group_admin_lsp"/>

    <!-- Allow Admin LSP and Asesor LSP to see Surveys menu -->
    <menuitem id="survey.menu_surveys" name="Surveys" groups="survey.group_survey_user,plugins_manajement_asesor.group_admin_lsp,plugins_manajement_asesor.group_asesor"/>

</odoo>
